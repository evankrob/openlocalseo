{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openlocalseo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  // The React SPA is served as static assets; API, MCP and public report data
  // go through the Worker first.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*"]
  },

  // Non-secret defaults. Secrets (DATAFORSEO_API_KEY, ...) go in .dev.vars
  // locally and `wrangler secret put` when you deploy your own copy.
  "vars": {
    "AUTH_MODE": "local_noauth",
    "BILLING_MODE": "byok",
    "DATAFORSEO_MODE": "mock",
    "BILLING_MARKUP": "1.28"
  },

  // Placeholder ids: this file serves local dev (wrangler/miniflare keeps its
  // state in .wrangler/). To deploy your own copy, create the resources and
  // replace the ids - see README "Self-hosting on Cloudflare".
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openlocalseo",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "openlocalseo" }],

  // Scan pipeline: "post" jobs submit grid tasks to DataForSEO, "poll" jobs
  // collect them. Jobs that exhaust their retries land in the dead-letter
  // queue, which the same Worker consumes (src/worker/queue.ts): it fails the
  // scan, refunds held credits and raises an alert.
  "queues": {
    "producers": [{ "binding": "SCAN_QUEUE", "queue": "openlocalseo-scans" }],
    "consumers": [
      {
        "queue": "openlocalseo-scans",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "dead_letter_queue": "openlocalseo-scans-dlq"
      },
      { "queue": "openlocalseo-scans-dlq", "max_batch_size": 5, "max_retries": 3 }
    ]
  },

  // Workers Rate Limiting bindings for the per-minute rules (see src/worker/ratelimit).
  // limit/period are fixed here; period must be 10 or 60. namespace_id is any
  // integer, unique per rule in your account. Without a binding the Worker falls
  // back to a D1 counter, so these are optional.
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_PUBLIC", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_API_KEY", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } }
  ],

  // Daily tick; the handler starts any monthly schedule whose next_run_at is
  // due (see src/worker/scheduled.ts).
  "triggers": { "crons": ["15 6 * * *"] },

  // Production (deployed 2026-10-16, behind Cloudflare Access).
  // Deploy: npx wrangler deploy --env production
  // Secret: DATAFORSEO_API_KEY (base64 of login:password) via wrangler secret put.
  "env": {
    "production": {
      "name": "openlocalseo",
      "workers_dev": true,
      "vars": {
        "AUTH_MODE": "cloudflare_access",
        "BILLING_MODE": "byok",
        "DATAFORSEO_MODE": "live",
        "BILLING_MARKUP": "1.28",
        "TEAM_DOMAIN": "https://raspy-scene-a7ef.cloudflareaccess.com",
        "POLICY_AUD": "aed019e1fb7fb2bdb326efc1feae1578fe6574c0f85a47a71da6f4c7c7815fec"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "openlocalseo", "database_id": "0b00378b-1f43-4de0-af67-fffc68836bcb", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "R2", "bucket_name": "openlocalseo" }],
      "queues": {
        "producers": [{ "binding": "SCAN_QUEUE", "queue": "openlocalseo-scans" }],
        "consumers": [
          { "queue": "openlocalseo-scans", "max_batch_size": 5, "max_batch_timeout": 2, "max_retries": 5, "dead_letter_queue": "openlocalseo-scans-dlq" },
          { "queue": "openlocalseo-scans-dlq", "max_batch_size": 5, "max_retries": 3 }
        ]
      },
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_PUBLIC", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_API_KEY", "namespace_id": "2003", "simple": { "limit": 600, "period": 60 } }
      ],
      "triggers": { "crons": ["15 6 * * *"] }
    }
  }
}
