# OpenLocalSEO configuration.
# Local dev: `cp .env.example .env`. Wrangler/Vite load .env (or .dev.vars) into
# the Worker. Nothing here is a real credential; never commit your own .env.
# Deployed: set non-secret values as `vars` in wrangler.jsonc and secrets with
# `npx wrangler secret put NAME`.

# -----------------------------------------------------------------------------
# Data source
# -----------------------------------------------------------------------------
# mock (default): deterministic simulated DataForSEO results, no network, no cost.
# live: real DataForSEO calls. Needs DATAFORSEO_API_KEY. Spends real money.
DATAFORSEO_MODE=mock

# Base64 of "login:password" from https://app.dataforseo.com/api-access
# Secret. Only read when DATAFORSEO_MODE=live.
# DATAFORSEO_API_KEY=

# Mock only: seconds before a queued mock task is "ready" (default 12 / 4).
# MOCK_STANDARD_DELAY_SECONDS=12
# MOCK_PRIORITY_DELAY_SECONDS=4

# Seconds between collection attempts. Defaults: mock 5/3, live 60 (standard) / 15 (priority).
# POLL_INTERVAL_SECONDS=

# -----------------------------------------------------------------------------
# Rate limits (requests per window; 0 = off). The per-minute rules use the
# Workers Rate Limiting bindings in wrangler.jsonc when present (then these three
# are ignored); otherwise a D1 counter. See README "Operations".
# -----------------------------------------------------------------------------
# RATE_LIMIT_AUTH_PER_MIN=10           # signup + login, per IP
# RATE_LIMIT_AUTH_PER_HOUR=30          # signup + login, per IP
# RATE_LIMIT_LOGIN_EMAIL_PER_HOUR=20   # login, per email
# RATE_LIMIT_PUBLIC_REPORT_PER_MIN=60  # public report links, per IP
# RATE_LIMIT_SCANS_PER_HOUR=30         # starting scans / profile refreshes, per workspace
# RATE_LIMIT_API_KEY_PER_MIN=600       # any request made with an API key, per key

# -----------------------------------------------------------------------------
# Data retention (days; 0 = keep forever). Scans and scan points are never pruned.
# -----------------------------------------------------------------------------
# RETENTION_SCAN_RESULTS_DAYS=400      # per-point competitor rows + raw R2 archive
# RETENTION_API_CALLS_DAYS=180
# RETENTION_RATE_LIMIT_ROWS=1

# -----------------------------------------------------------------------------
# Auth mode
# -----------------------------------------------------------------------------
# local_noauth      Local development only. One implicit admin (admin@localhost).
#                   The Worker refuses non-loopback hostnames in this mode.
# cloudflare_access Validate Cloudflare Access JWTs (recommended for self-hosting).
#                   Everyone behind the Access app shares one workspace.
# hosted            Email + password accounts, multiple workspaces (SaaS mode).
# Unset defaults to cloudflare_access.
AUTH_MODE=local_noauth

# Required when AUTH_MODE=cloudflare_access
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-access-application-aud-tag

# -----------------------------------------------------------------------------
# Billing mode
# -----------------------------------------------------------------------------
# byok    You pay DataForSEO directly with your own key. Cost is tracked per call.
# hosted  Workspaces spend prepaid credits: DataForSEO cost x BILLING_MARKUP.
BILLING_MODE=byok

# Hosted only
# BILLING_MARKUP=1.28          # +28% on DataForSEO cost (same as open-seo)
# HOSTED_FREE_CREDITS=100      # credits granted to each new workspace (1000 = $1)
# ADMIN_TOKEN=                 # long random secret enabling POST /api/admin/credits top-ups
